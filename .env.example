PORT=3000
MASTRA_STORAGE_URL=file:./mastra.db
MASTRA_STORAGE_AUTH_TOKEN=
MASTRA_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
EVIDENCE_IDENTITY_TIMEOUT_MS=1500
EVIDENCE_ENDPOINT_TIMEOUT_MS=1500
EVIDENCE_CLOUD_TIMEOUT_MS=1500

# Phase 3 uses local BGE Small EN v1.5 embeddings (384 dimensions).
# The first explicit `npm run runbooks:index` may download the model here.
RUNBOOK_FASTEMBED_CACHE_DIR=.cache/fastembed

# Phase 2 is intentionally mock-only. Generate both with: openssl rand -hex 32
DEMO_MODE=mock
WEBHOOKS_ENABLED=true
ALERT_WEBHOOK_SECRET=
WORKOS_WEBHOOK_SECRET=
ALERT_WEBHOOK_SOURCES=demo
WEBHOOK_MAX_BODY_BYTES=65536
MASTRA_MAX_BODY_BYTES=1048576
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=16
OUTBOX_LEASE_MS=10000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_MS=500
OUTBOX_BACKOFF_CAP_MS=30000
OUTBOX_RECOVERY_GRACE_MS=10000

# Phase 6 synthetic approval is opt-in and mock-only. Generate two independent
# values with `openssl rand -hex 32`. Staging/production reject this actor.
MOCK_DECISIONS_ENABLED=false
MOCK_DECISION_SECRET=
APPROVAL_RESUME_SECRET=
CONTAINMENT_ACTION_TIMEOUT_MS=1000
CONTAINMENT_RATE_LIMIT=8

# Phase 7 dashboard/AuthKit is opt-in. The default remains hermetic mock mode.
# Generate the two local secrets independently with `openssl rand -hex 32`.
DASHBOARD_AUTH_ENABLED=false
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_COOKIE_PASSWORD=
DASHBOARD_ORIGIN=http://localhost:3000
DASHBOARD_CSRF_SECRET=
DASHBOARD_SESSION_MAX_AGE_SECONDS=28800
DASHBOARD_SSE_MAX_CONNECTIONS=4

# Phase 8 real domain providers are staging-only and opt-in. Leave every
# identifier/secret blank: literal <placeholders> are rejected fail-closed.
WORKOS_PROVIDER_ENABLED=false
WORKOS_WEBHOOK_PREVIOUS_SECRET=
WORKOS_STAGING_ORGANIZATION_ID=<workos_staging_organization_id>
WORKOS_STAGING_ALLOWED_USER_IDS=<workos_staging_user_ids_csv>
WORKOS_STAGING_ALLOWED_ROLE_SLUGS=<workos_staging_role_slugs_csv>

IPINFO_PROVIDER_ENABLED=false
IPINFO_TOKEN=
# Required only when IPINFO_PROVIDER_ENABLED=true. Use exactly a 32+ byte key
# with an explicit encoding prefix and a stable explicit version label.
GEOIP_CACHE_HMAC_KEY=base64:<minimum_32_byte_dedicated_cache_key>
GEOIP_CACHE_HMAC_KEY_VERSION=hmac-sha256-v1
# Previous key and version are paired for read-through rotation; remove both
# after TTL + retention. The previous version must be the version under which
# that key originally wrote cache entries.
GEOIP_CACHE_HMAC_PREVIOUS_KEY=
GEOIP_CACHE_HMAC_PREVIOUS_KEY_VERSION=
IPINFO_TIMEOUT_MS=1500
IPINFO_CACHE_TTL_SECONDS=86400
IPINFO_EVIDENCE_RETENTION_DAYS=30
IPINFO_CONFIDENCE=0.70

LINEAR_PROVIDER_ENABLED=false
LINEAR_API_KEY=
LINEAR_WORKSPACE_ID=<linear_workspace_id>
LINEAR_TEAM_ID=<linear_team_id>
LINEAR_PROJECT_ID=<linear_project_id_optional>
LINEAR_SEVERITY_LABEL_IDS_JSON=<linear_severity_label_ids_json>
LINEAR_STATUS_STATE_IDS_JSON=<linear_status_state_ids_json>
LINEAR_INTERNAL_BASE_URL=<https_internal_incident_base_url>

UPSTASH_PUBSUB_ENABLED=false
UPSTASH_REDIS_URL=<rediss_upstash_endpoint>
UPSTASH_REDIS_KEY_PREFIX=mastra:security:v1
UPSTASH_WORKFLOW_CONSUMER_GROUP=security-workflow-starters
UPSTASH_CONSUMER_CONCURRENCY=4
UPSTASH_MAX_DELIVERY_ATTEMPTS=5
UPSTASH_RETRY_BACKOFF_MS=500,1000,2000,4000
UPSTASH_RECLAIM_INTERVAL_MS=30000
UPSTASH_RECLAIM_IDLE_MS=60000
UPSTASH_STREAM_MAX_LENGTH=100000
UPSTASH_STREAM_IDLE_TTL_MS=0
