{
  "name": "mastra-security-incident",
  "version": "0.1.0",
  "private": true,
  "description": "Baseline for a security incident triage and response template built with Mastra.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env --import tsx src/start.ts",
    "dev:studio": "mastra dev",
    "fixture:sign": "node --env-file-if-exists=.env scripts/sign-webhook.mjs scripts/fixtures/phase2-alert.json",
    "demo": "node --import tsx scripts/phase9-demo.mts",
    "demo:surfaces": "node --no-deprecation --import tsx scripts/phase9-demo-surfaces.mts",
    "build": "npm run runbooks:validate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/start.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "runbooks:validate": "node --import tsx scripts/runbooks.mts validate",
    "runbooks:index": "node --import tsx scripts/runbooks.mts index",
    "runbooks:inspect": "node --import tsx scripts/runbooks.mts inspect",
    "runbooks:rollback": "node --import tsx scripts/runbooks.mts rollback",
    "runbooks:cleanup": "node --import tsx scripts/runbooks.mts cleanup",
    "staging:workos:check": "node --env-file-if-exists=.env --import tsx scripts/phase8-staging-harness.mts workos",
    "staging:ipinfo:check": "node --env-file-if-exists=.env --import tsx scripts/phase8-staging-harness.mts ipinfo",
    "staging:linear:check": "node --env-file-if-exists=.env --import tsx scripts/phase8-staging-harness.mts linear",
    "staging:upstash:check": "node --env-file-if-exists=.env --import tsx scripts/phase8-staging-harness.mts upstash",
    "audit": "npm audit --audit-level=high",
    "postinstall": "node scripts/apply-vendored-redis-streams-patch.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@libsql/client": "0.17.4",
    "@linear/sdk": "92.0.0",
    "@mastra/auth-workos": "1.6.4",
    "@mastra/core": "1.63.0",
    "@mastra/fastembed": "1.2.0",
    "@mastra/hono": "1.7.3",
    "@mastra/libsql": "1.22.0",
    "@mastra/observability": "1.17.3",
    "@mastra/rag": "2.6.0",
    "@mastra/redis-streams": "0.4.0",
    "@workos-inc/node": "8.13.0",
    "hono": "4.13.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "mastra": "1.27.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
